---
import { projects } from '@/constants'

const total = projects.length
const pad = (n: number) => String(n).padStart(2, '0')
---

<section id="projects" class="projects">
  <div class="p-head">
    <p class="p-eyebrow">Proyectos</p>
    <h2 class="p-title">Cosas que he construido</h2>
  </div>

  <div class="p-stage">
    <div class="p-inner">
      <!-- Texto (crossfade por proyecto) -->
      <div class="p-text">
        {projects.map((p, i) => (
          <article class:list={['p-panel', { 'is-active': i === 0 }]} data-panel={i}>
            <span class="p-index">{pad(i + 1)} / {pad(total)}</span>
            <h3 class="p-name">{p.title}</h3>
            <p class="p-desc">{p.description}</p>
            <ul class="p-tech">
              {p.technologies.map((t) => <li>{t}</li>)}
            </ul>
            <div class="p-links">
              {p.repoUrl && (
                <a href={p.repoUrl} target="_blank" rel="noopener noreferrer" class="p-link">Código →</a>
              )}
              {p.deployUrl && (
                <a href={p.deployUrl} target="_blank" rel="noopener noreferrer" class="p-link p-link--solid">Ver demo →</a>
              )}
            </div>
            <!-- imagen inline (solo móvil) -->
            <img class="p-panel-img" src={p.image} alt={p.title} decoding="async" />
          </article>
        ))}
      </div>

      <!-- Ventana enmarcada con las imágenes que se deslizan -->
      <div class="p-window">
        <!-- Patrón animado de fondo (matriz de puntos + partículas azules) -->
        <div class="p-pattern-bg" aria-hidden="true"></div>

        <div class="p-track">
          {projects.map((p) => (
            <div class="p-slide">
              <img src={p.image} alt={p.title} decoding="async" />
            </div>
          ))}
        </div>
        <div class="p-frame-border"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .projects {
    background: #0b0b12;
    color: #f5f5f7;
  }

  .p-head {
    text-align: center;
    padding: 4rem 1.5rem 0;
  }
  .p-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.75rem;
    font-weight: 600;
    color: #8b8b8b;
    margin: 0 0 0.5rem;
  }
  .p-title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .p-stage {
    height: 100vh;
    display: flex;
    align-items: center;
  }
  .p-inner {
    width: 100%;
    max-width: 82rem;
    margin: 0 auto;
    padding: 0 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 3rem;
  }

  /* Texto ------------------------------------------------------------- */
  .p-text {
    position: relative;
    min-height: 24rem;
  }
  .p-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    opacity: 0;
  }
  .p-panel.is-active {
    opacity: 1;
  }
  .p-index {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #6aa9ff;
  }
  .p-name {
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }
  .p-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    font-weight: 300;
    color: #b8b5c5;
    margin: 0;
    max-width: 32rem;
    text-wrap: pretty;
  }
  .p-tech {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .p-tech li {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #d6d3e0;
  }
  .p-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .p-link {
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    color: #f5f5f7;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .p-link:hover {
    background: #f5f5f7;
    color: #0b0b12;
    border-color: #f5f5f7;
  }
  .p-link--solid {
    background: #2f6df0;
    border-color: #2f6df0;
  }
  .p-link--solid:hover {
    background: #2258d0;
    border-color: #2258d0;
    color: #fff;
  }
  .p-panel-img {
    display: none;
  }

  /* Ventana ----------------------------------------------------------- */
  .p-window {
    position: relative;
    height: 68vh;
    border-radius: 1.5rem;
    overflow: hidden;
    /* border: 1px solid rgba(255, 255, 255, 0.1); */
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.9);
  }
  /* Patrón de fondo animado (matriz de puntos + partículas azules) ----- */
  .p-pattern-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #000;
  }
  .p-pattern-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: radial-gradient(
      circle at 50% 50%,
      #0000 0,
      #0000 2px,
      hsl(0 0 4%) 2px
    );
    background-size: 8px 8px;
    animation: 5s ease-in-out p-hiii infinite;
    --f: blur(3em) brightness(9);
  }
  @keyframes p-hiii {
    0% { backdrop-filter: var(--f) hue-rotate(0deg); }
    25% { backdrop-filter: var(--f) hue-rotate(-25deg); }
    28% { backdrop-filter: var(--f) hue-rotate(0deg); }
    32% { backdrop-filter: var(--f) hue-rotate(-20deg); }
    39% { backdrop-filter: var(--f) hue-rotate(0deg); }
    40% { backdrop-filter: var(--f) hue-rotate(-20deg); }
    41% { backdrop-filter: var(--f) hue-rotate(0deg); }
    42% { backdrop-filter: var(--f) hue-rotate(-25deg); }
    44% { backdrop-filter: var(--f) hue-rotate(0deg); }
    58% { backdrop-filter: var(--f) hue-rotate(-20deg); }
    64% { backdrop-filter: var(--f) hue-rotate(0deg); }
    80% { backdrop-filter: var(--f) hue-rotate(-25deg); }
    to { backdrop-filter: var(--f) hue-rotate(0deg); }
  }
  .p-pattern-bg::before {
    content: '';
    position: absolute;
    inset: -145%;
    rotate: -45deg;
    --c: #42608a; /* azul acero (partículas) */
    --c1: #7fa8de; /* azul claro (cabezas) */
    background-image: radial-gradient(4px 100px at 0px 235px, var(--c), #0000),
      radial-gradient(4px 100px at 300px 235px, var(--c), #0000),
      radial-gradient(3px 4px at 150px 117.5px, var(--c1) 100%, #0000 150%),
      radial-gradient(4px 100px at 0px 252px, var(--c), #0000),
      radial-gradient(4px 100px at 300px 252px, var(--c), #0000),
      radial-gradient(3px 4px at 150px 126px, var(--c1) 100%, #0000 150%),
      radial-gradient(4px 100px at 0px 150px, var(--c), #0000),
      radial-gradient(4px 100px at 300px 150px, var(--c), #0000),
      radial-gradient(3px 4px at 150px 75px, var(--c1) 100%, #0000 150%),
      radial-gradient(4px 100px at 0px 253px, var(--c), #0000),
      radial-gradient(4px 100px at 300px 253px, var(--c), #0000),
      radial-gradient(3px 4px at 150px 126.5px, var(--c1) 100%, #0000 150%),
      radial-gradient(4px 100px at 0px 204px, var(--c), #0000),
      radial-gradient(4px 100px at 300px 204px, var(--c), #0000),
      radial-gradient(3px 4px at 150px 102px, var(--c1) 100%, #0000 150%),
      radial-gradient(4px 100px at 0px 134px, var(--c), #0000),
      radial-gradient(4px 100px at 300px 134px, var(--c), #0000),
      radial-gradient(3px 4px at 150px 67px, var(--c1) 100%, #0000 150%),
      radial-gradient(4px 100px at 0px 179px, var(--c), #0000),
      radial-gradient(4px 100px at 300px 179px, var(--c), #0000),
      radial-gradient(3px 4px at 150px 89.5px, var(--c1) 100%, #0000 150%),
      radial-gradient(4px 100px at 0px 299px, var(--c), #0000),
      radial-gradient(4px 100px at 300px 299px, var(--c), #0000),
      radial-gradient(3px 4px at 150px 149.5px, var(--c1) 100%, #0000 150%),
      radial-gradient(4px 100px at 0px 215px, var(--c), #0000),
      radial-gradient(4px 100px at 300px 215px, var(--c), #0000),
      radial-gradient(3px 4px at 150px 107.5px, var(--c1) 100%, #0000 150%),
      radial-gradient(4px 100px at 0px 281px, var(--c), #0000),
      radial-gradient(4px 100px at 300px 281px, var(--c), #0000),
      radial-gradient(3px 4px at 150px 140.5px, var(--c1) 100%, #0000 150%),
      radial-gradient(4px 100px at 0px 158px, var(--c), #0000),
      radial-gradient(4px 100px at 300px 158px, var(--c), #0000),
      radial-gradient(3px 4px at 150px 79px, var(--c1) 100%, #0000 150%),
      radial-gradient(4px 100px at 0px 210px, var(--c), #0000),
      radial-gradient(4px 100px at 300px 210px, var(--c), #0000),
      radial-gradient(3px 4px at 150px 105px, var(--c1) 100%, #0000 150%);
    background-size:
      300px 235px, 300px 235px, 300px 235px,
      300px 252px, 300px 252px, 300px 252px,
      300px 150px, 300px 150px, 300px 150px,
      300px 253px, 300px 253px, 300px 253px,
      300px 204px, 300px 204px, 300px 204px,
      300px 134px, 300px 134px, 300px 134px,
      300px 179px, 300px 179px, 300px 179px,
      300px 299px, 300px 299px, 300px 299px,
      300px 215px, 300px 215px, 300px 215px,
      300px 281px, 300px 281px, 300px 281px,
      300px 158px, 300px 158px, 300px 158px,
      300px 210px, 300px 210px, 300px 210px;
    animation: p-hi 150s linear infinite;
  }
  @keyframes p-hi {
    0% {
      background-position:
        0px 220px, 3px 220px, 151.5px 337.5px,
        25px 24px, 28px 24px, 176.5px 150px,
        50px 16px, 53px 16px, 201.5px 91px,
        75px 224px, 78px 224px, 226.5px 350.5px,
        100px 19px, 103px 19px, 251.5px 121px,
        125px 120px, 128px 120px, 276.5px 187px,
        150px 31px, 153px 31px, 301.5px 120.5px,
        175px 235px, 178px 235px, 326.5px 384.5px,
        200px 121px, 203px 121px, 351.5px 228.5px,
        225px 224px, 228px 224px, 376.5px 364.5px,
        250px 26px, 253px 26px, 401.5px 105px,
        275px 75px, 278px 75px, 426.5px 180px;
    }
    to {
      background-position:
        0px 6800px, 3px 6800px, 151.5px 6917.5px,
        25px 13632px, 28px 13632px, 176.5px 13758px,
        50px 5416px, 53px 5416px, 201.5px 5491px,
        75px 17175px, 78px 17175px, 226.5px 17301.5px,
        100px 5119px, 103px 5119px, 251.5px 5221px,
        125px 8428px, 128px 8428px, 276.5px 8495px,
        150px 9876px, 153px 9876px, 301.5px 9965.5px,
        175px 13391px, 178px 13391px, 326.5px 13540.5px,
        200px 14741px, 203px 14741px, 351.5px 14848.5px,
        225px 18770px, 228px 18770px, 376.5px 18910.5px,
        250px 5082px, 253px 5082px, 401.5px 5161px,
        275px 6375px, 278px 6375px, 426.5px 6480px;
    }
  }
  .p-track {
    position: relative;
    z-index: 1;
    will-change: transform;
  }
  .p-slide {
    height: 68vh;
    display: grid;
    place-items: center;
  }
  .p-slide img {
    max-height: 80%;
    max-width: 88%;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 22px 50px -18px rgba(0, 0, 0, 0.8);
  }
  /* Marco interior decorativo */
  .p-frame-border {
    position: absolute;
    inset: 0.9rem;
    z-index: 2;
    border-radius: 1rem;
    pointer-events: none;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12) inset;
  }

  /* Responsive: sin pin, stack normal --------------------------------- */
  @media (max-width: 820px) {
    .p-stage {
      height: auto;
      display: block;
    }
    .p-inner {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 1rem 1.25rem 3rem;
    }
    .p-text {
      min-height: 0;
    }
    .p-panel {
      position: static;
      opacity: 1;
      inset: auto;
      padding: 2rem 0;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .p-panel:first-child {
      border-top: none;
    }
    .p-panel-img {
      display: block;
      width: 100%;
      margin-top: 1.5rem;
      border-radius: 12px;
    }
    .p-window {
      display: none;
    }
  }
</style>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const panels = gsap.utils.toArray<HTMLElement>('.p-panel')
  const n = panels.length

  const mm = gsap.matchMedia()

  // Efecto solo en desktop (>=821px)
  mm.add('(min-width: 821px)', () => {
    gsap.set(panels, { autoAlpha: 0 })
    gsap.set(panels[0], { autoAlpha: 1 })
    gsap.set('.p-track', { yPercent: 0 })

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '.p-stage',
        start: 'top top',
        end: () => `+=${(n - 1) * 70}%`,
        pin: true,
        scrub: 1,
        invalidateOnRefresh: true,
      },
    })

    for (let i = 0; i < n - 1; i++) {
      // desliza el track para mostrar la siguiente imagen
      tl.to('.p-track', { yPercent: -(100 / n) * (i + 1), ease: 'none', duration: 1 }, i)
      // crossfade del texto a mitad del tramo
      tl.to(panels[i], { autoAlpha: 0, ease: 'none', duration: 0.4 }, i + 0.3)
      tl.to(panels[i + 1], { autoAlpha: 1, ease: 'none', duration: 0.4 }, i + 0.3)
    }

    return () => tl.kill()
  })

  // Recalcular cuando carguen las imágenes
  window.addEventListener('load', () => ScrollTrigger.refresh())
</script>
