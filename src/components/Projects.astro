        <div class="p-track">
          {projects.map((p) => (
            <div class="p-slide">
              <img src={p.image} alt={p.title} decoding="async" />
            </div>
          ))}
        </div>
        <div class="p-frame-border"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .projects {
    background: #0b0b12;
    color: #f5f5f7;
  }

  .p-head {
    text-align: center;
    padding: 4rem 1.5rem 0;
  }
  .p-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.75rem;
    font-weight: 600;
    color: #8b8b8b;
    margin: 0 0 0.5rem;
  }
  .p-title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .p-stage {
    height: 100vh;
    display: flex;
    align-items: center;
  }
  .p-inner {
    width: 100%;
    max-width: 82rem;
    margin: 0 auto;
    padding: 0 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 3rem;
  }

  /* Texto ------------------------------------------------------------- */
  .p-text {
    position: relative;
    min-height: 24rem;
  }
  .p-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    opacity: 0;
  }
  .p-panel.is-active {
    opacity: 1;
  }
  .p-index {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #6aa9ff;
  }
  .p-name {
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }
  .p-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    font-weight: 300;
    color: #b8b5c5;
    margin: 0;
    max-width: 32rem;
    text-wrap: pretty;
  }
  .p-tech {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .p-tech li {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #d6d3e0;
  }
  .p-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .p-link {
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    color: #f5f5f7;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .p-link:hover {
    background: #f5f5f7;
    color: #0b0b12;
    border-color: #f5f5f7;
  }
  .p-link--solid {
    background: #2f6df0;
    border-color: #2f6df0;
  }
  .p-link--solid:hover {
    background: #2258d0;
    border-color: #2258d0;
    color: #fff;
  }
  .p-panel-img {
    display: none;
  }

  /* Ventana ----------------------------------------------------------- */
  .p-window {
    position: relative;
    height: 68vh;
    border-radius: 1.5rem;
    overflow: hidden;
    /* border: 1px solid rgba(255, 255, 255, 0.1); */
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.9);
  }
  .p-pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .p-track {
    position: relative;
    z-index: 1;
    will-change: transform;
  }
  .p-slide {
    height: 68vh;
    display: grid;
    place-items: center;
    padding: 2.5rem;
  }
  .p-slide img {
    max-height: 80%;
    max-width: 88%;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 22px 50px -18px rgba(0, 0, 0, 0.8);
  }
  /* Marco interior decorativo */
  .p-frame-border {
    position: absolute;
    inset: 0.9rem;
    z-index: 2;
    border-radius: 1rem;
    pointer-events: none;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12) inset;
  }

  /* Responsive: sin pin, stack normal --------------------------------- */
  @media (max-width: 820px) {
    .p-stage {
      height: auto;
      display: block;
    }
    .p-inner {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 1rem 1.25rem 3rem;
    }
    .p-text {
      min-height: 0;
    }
    .p-panel {
      position: static;
      opacity: 1;
      inset: auto;
      padding: 2rem 0;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .p-panel:first-child {
      border-top: none;
    }
    .p-panel-img {
      display: block;
      width: 100%;
      margin-top: 1.5rem;
      border-radius: 12px;
    }
    .p-window {
      display: none;
    }
  }
</style>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const panels = gsap.utils.toArray<HTMLElement>('.p-panel')
  const n = panels.length

  const mm = gsap.matchMedia()

  // Efecto solo en desktop (>=821px)
  mm.add('(min-width: 821px)', () => {
    gsap.set(panels, { autoAlpha: 0 })
    gsap.set(panels[0], { autoAlpha: 1 })
    gsap.set('.p-track', { yPercent: 0 })

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '.p-stage',
        start: 'top top',
        end: () => `+=${(n - 1) * 70}%`,
        pin: true,
        scrub: 1,
        invalidateOnRefresh: true,
      },
    })

    for (let i = 0; i < n - 1; i++) {
      // desliza el track para mostrar la siguiente imagen
      tl.to('.p-track', { yPercent: -(100 / n) * (i + 1), ease: 'none', duration: 1 }, i)
      // crossfade del texto a mitad del tramo
      tl.to(panels[i], { autoAlpha: 0, ease: 'none', duration: 0.4 }, i + 0.3)
      tl.to(panels[i + 1], { autoAlpha: 1, ease: 'none', duration: 0.4 }, i + 0.3)
    }

    return () => tl.kill()
  })

  // Recalcular cuando carguen las imágenes
  window.addEventListener('load', () => ScrollTrigger.refresh())
</script>
