---
// Efecto de scroll: verbos que se iluminan al pasar por la banda central,
// y luego un panel que revela el mensaje de contacto.
// Adaptado a mis servicios (backend, automatización, fullstack).
import BongoCat from '@/components/BongoCat.astro'

const verbs = [
  'automatizar.',
  'integrar.',
  'diseñar.',
  'construir.',
  'optimizar.',
  'desplegar.',
];
---

<div id="contact" class="contact-scroll" data-animate="true">
  <header class="contact-header" style={`--count: ${verbs.length}`}>
    <section>
      <h1>
        <span aria-hidden="true">yo puedo&nbsp;</span>
        <span class="sr-only">yo puedo desplegar.</span>
      </h1>
      <ul aria-hidden="true">
        {verbs.map((verb, i) => (
          <li style={`--i: ${i}`}>{verb}</li>
        ))}
      </ul>
    </section>
  </header>

  <main class="contact-main">
    <section>
      <p>
        y te muestro cómo.<br />
        <a href="mailto:buitragoivancamilo1025@gmail.com">hablemos</a>.
      </p>

      <div class="socials">
        <a
          href="https://github.com/codigo-natural"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="social"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/ivancamilobuitrago/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="social"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
          </svg>
        </a>
      </div>

      <BongoCat />
    </section>
  </main>

  <footer class="contact-footer">ʕ⊙ᴥ⊙ʔ Iván Camilo &copy; 2026</footer>
</div>

<style>
  .contact-scroll {
    --start: 50vh;
    --space: 40vh;
    --hue: 265;
    --accent: light-dark(hsl(var(--hue) 100% 45%), hsl(var(--hue) 90% 72%));
  }

  /* Verbos que se iluminan al pasar por la banda central --------------- */
  .contact-header {
    position: sticky;
    top: calc((var(--count) - 1) * -1lh);
    line-height: 1.2;
    display: flex;
    align-items: flex-start;
    width: 100%;
    margin-bottom: var(--space);
    font-size: clamp(2rem, 8vw, 5rem);
    font-weight: 600;
  }

  .contact-header section {
    display: flex;
    width: 100%;
    align-items: flex-start;
    justify-content: center;
    padding-top: calc(var(--start) - 0.5lh);
  }

  .contact-header h1 {
    position: sticky;
    top: calc(var(--start) - 0.5lh);
    font-size: inherit;
    margin: 0;
    display: inline-block;
    height: fit-content;
    font-weight: 600;
  }

  .contact-header ul {
    font-weight: 600;
    padding-inline: 0;
    margin: 0;
    list-style-type: none;
  }

  .contact-header li {
    --dimmed: color-mix(in oklch, canvasText, transparent 82%);
    background: linear-gradient(
      180deg,
      var(--dimmed) 0 calc(var(--start) - 0.5lh),
      var(--accent) calc(var(--start) - 0.55lh) calc(var(--start) + 0.55lh),
      var(--dimmed) calc(var(--start) + 0.5lh)
    );
    background-attachment: fixed;
    color: transparent;
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* Panel de reveal ---------------------------------------------------- */
  .contact-main {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    place-items: center;
    justify-content: center;
    z-index: 2;
    color: canvas;
  }

  .contact-main::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: light-dark(#000, #fff);
    border-radius: 1rem 1rem 0 0;
  }

  .contact-main section {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    text-align: center;
    font-size: clamp(1.5rem, 4vw, 2.75rem);
  }

  .contact-main p {
    margin: 0;
    font-weight: 600;
  }

  .contact-main a:not(.social) {
    color: var(--accent);
    text-decoration: none;
    text-underline-offset: 0.15em;
  }

  .contact-main a:not(.social):is(:hover, :focus-visible) {
    text-decoration: underline;
  }

  .socials {
    display: flex;
    gap: 1.5rem;
  }

  .social {
    color: currentColor;
    opacity: 0.7;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .social:is(:hover, :focus-visible) {
    opacity: 1;
    transform: translateY(-2px);
  }

  /* Reveal progresivo con scroll (progressive enhancement) ------------- */
  @supports (animation-timeline: view()) {
    .contact-scroll[data-animate='true'] .contact-main {
      view-timeline: --section;
    }
    .contact-scroll[data-animate='true'] .contact-main::before {
      transform-origin: 50% 100%;
      scale: 0.9;
      animation: contact-grow both ease-in-out;
      animation-timeline: --section;
      animation-range: entry 50%;
    }
    .contact-scroll[data-animate='true'] .contact-main section {
      animation: contact-reveal both ease-in-out;
      animation-timeline: --section;
      animation-range: entry 50%;
    }

    @keyframes contact-grow {
      100% {
        scale: 1;
        border-radius: 0;
      }
    }
    @keyframes contact-reveal {
      0% {
        opacity: 0;
      }
    }
  }

  .contact-footer {
    padding-block: 2rem;
    font-size: 0.875rem;
    font-weight: 300;
    text-align: center;
    width: 100%;
    background: light-dark(#000, #fff);
    color: color-mix(in hsl, canvas, transparent 40%);
    position: relative;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
