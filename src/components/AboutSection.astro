---
import SectionTest from "@/components/sectionTest.astro";

const githubUsername = "codigo-natural";
const githubUrl = "https://api.github.com";
const githubUserResponse = await fetch(`${githubUrl}/users/${githubUsername}`);
const githubUser = await githubUserResponse.json();

const githubReposResponse = await fetch(`${githubUrl}/users/${githubUsername}/repos?per_page=100&sort=updated`);
const githubRepos = await githubReposResponse.json();

// Ensure githubRepos is always an array
const repos = Array.isArray(githubRepos) ? githubRepos : [];

// Fetch featured project (vetcerca)
const featuredRepoResponse = await fetch(`${githubUrl}/repos/${githubUsername}/vetcerca`);
const featuredRepo = await featuredRepoResponse.json();

// Fetch motivational quote with fallback
let quoteData = { content: "Code is like humor. When you have to explain it, it's bad.", author: "Cory House" };
try {
  const quoteResponse = await fetch('https://api.quotable.io/random?tags=technology,programming&maxLength=100');
  if (quoteResponse.ok) {
    quoteData = await quoteResponse.json();
  }
} catch (e) {
  // Fallback to hardcoded quote if API fails
}

// Calculate years on GitHub
const createdAt = new Date(githubUser.created_at);
const yearsOnGithub = Math.floor((new Date() - createdAt) / (1000 * 60 * 60 * 24 * 365));

// Get top languages
const languages = repos.reduce((acc, repo) => {
  if (repo.language) {
    acc[repo.language] = (acc[repo.language] || 0) + 1;
  }
  return acc;
}, {});

const topLanguages = Object.entries(languages)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 3)
  .map(([lang]) => lang);

// Get starred repos count
const totalStars = repos.reduce((acc, repo) => acc + repo.stargazers_count, 0);

// Get recent activity (repos updated in last 30 days)
const thirtyDaysAgo = new Date();
thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
const recentActivity = repos.filter(repo => new Date(repo.updated_at) > thirtyDaysAgo).length;
---

<div class="grid my-8 grid-cols-[850px_1fr] gap-4 mx-8 ml-0">
    <!-- Sidebar (About Me) - spans all rows -->
    <SectionTest class="row-span-3 bg-blue-100" />

    <!-- Right column - nested grid -->
    <div class="grid grid-cols-[2fr_1fr] grid-rows-[auto_1fr_auto] gap-4">
        <!-- Row 1: Header -->
        <div class="col-span-2 p-2 h-auto">
            <h1 class="text-9xl font-expanded font-extrabold">Portfolio</h1>
        </div>

        <!-- Row 2: Hero Card + Stats Stack -->
        <a href={featuredRepo.html_url} target="_blank" rel="noopener noreferrer" class="bg-green-100 rounded-[4em] p-6 block hover:bg-green-200 transition-colors">
            <div class="flex items-start justify-between mb-4">
                <div>
                    <h2 class="text-2xl font-bold mb-2">{featuredRepo.name}</h2>
                    <span class="inline-block px-3 py-1 bg-yellow-400 text-xs font-semibold rounded-full mb-2">En construcción</span>
                </div>
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/>
                </svg>
            </div>
            <p class="text-sm text-gray-700 mb-4">{featuredRepo.description}</p>
            <div class="flex items-center gap-4 text-sm text-gray-600">
                <div class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                    </svg>
                    <span>{featuredRepo.language}</span>
                </div>
                <div class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                        <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                    </svg>
                    <span>Ver proyecto</span>
                </div>
            </div>
        </a>
        <div class="grid grid-rows-[1fr_1fr]">
            <div class="bg-yellow-100 p-4 flex flex-col justify-center items-center rounded-tl-[4em] rounded-tr-[4em]">
                <section class="space-y-2">
                    <div class="flex items-center gap-2">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10 2a8 8 0 100 16 8 8 0 000-16zm0 14a6 6 0 110-12 6 6 0 010 12z"/>
                        </svg>
                        <span class="font-bold text-2xl">{githubUser.public_repos}</span>
                        <span class="text-3xl">Repos</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                        <span class="font-bold text-2xl">{totalStars}</span>
                        <span class="text-3xl">Stars</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                        </svg>
                        <span class="font-bold text-2xl">{yearsOnGithub}</span>
                        <span class="text-3xl">Years</span>
                    </div>
                </section>
            </div>
            <div class="bg-pink-100 p-4 flex flex-col justify-center items-center rounded-bl-[4em] rounded-br-[4em]">
                <section class="space-y-1">
                    <h3 class="font-bold text-4xl mb-2">Top Languages</h3>
                    {topLanguages.map(lang => (
                        <div class="flex items-center gap-2">
                            <div class="w-2 h-2 rounded-full bg-pink-500"></div>
                            <span class="text-3xl">{lang}</span>
                        </div>
                    ))}
                    <div class="mt-2 pt-2 border-t border-pink-300">
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"/>
                            </svg>
                            <span class="text-xl">{recentActivity} active repos</span>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <!-- Row 3: Bottom Cards Row -->
        <div class="col-span-2 grid grid-cols-[1fr_1fr_1fr] gap-4">
            <div class="bg-purple-100 rounded-[2em] flex flex-col items-center p-4">
                <h3 class="font-bold text-3xl mb-3">Clients</h3>
                <div class="space-y-2">
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 rounded-full bg-purple-500"></div>
                        <span class="text-2xl">Voltiva</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 rounded-full bg-purple-500"></div>
                        <span class="text-2xl">Just Mobile Security</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 rounded-full bg-purple-500"></div>
                        <span class="text-2xl">Callbook AI</span>
                    </div>
                </div>
            </div>
            <div class="bg-orange-100 p-4 flex flex-col justify-center rounded-tl-[2em] rounded-bl-[2em]">
                <div class="flex items-start gap-2">
                    <svg class="w-5 h-5 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                    </svg>
                    <p class="text-3xl italic text-gray-700">"{quoteData.content}"</p>
                </div>
                <p class="text-2xl text-gray-500 mt-2 text-right">— {quoteData.author}</p>
            </div>
            <div class="bg-teal-100 p-4">
                <h3 class="font-bold text-sm mb-3">Awards & Certs</h3>
                <div class="space-y-2">
                    <div class="text-xs">
                        <div class="font-semibold">KodeKloud</div>
                        <div class="text-gray-600">DevOps Engineer</div>
                    </div>
                    <div class="text-xs">
                        <div class="font-semibold">Coursera</div>
                        <div class="text-gray-600">Data Analysis</div>
                    </div>
                    <div class="text-xs">
                        <div class="font-semibold">Platzi</div>
                        <div class="text-gray-600">Multiple Courses</div>
                    </div>
                    <a href="https://www.linkedin.com/in/ivancamilobuitrago" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs text-blue-600 hover:underline mt-2">
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd"/>
                        </svg>
                        LinkedIn
                    </a>
                </div>
            </div>
        </div>
    </div>
    </div>
</div>
