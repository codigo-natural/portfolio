---
import SectionTest from "@/components/sectionTest.astro";

const githubUsername = "codigo-natural";
const githubUrl = "https://api.github.com";
const githubUserResponse = await fetch(`${githubUrl}/users/${githubUsername}`);
const githubUser = await githubUserResponse.json();

const githubReposResponse = await fetch(`${githubUrl}/users/${githubUsername}/repos?per_page=100&sort=updated`);
const githubRepos = await githubReposResponse.json();

// Ensure githubRepos is always an array
const repos = Array.isArray(githubRepos) ? githubRepos : [];

// Fetch featured project (vetcerca)
const featuredRepoResponse = await fetch(`${githubUrl}/repos/${githubUsername}/vetcerca`);
const featuredRepo = await featuredRepoResponse.json();

// Fetch motivational quote with fallback
let quoteData = { content: "Code is like humor. When you have to explain it, it's bad.", author: "Cory House" };
try {
  const quoteResponse = await fetch('https://api.quotable.io/random?tags=technology,programming&maxLength=100');
  if (quoteResponse.ok) {
    quoteData = await quoteResponse.json();
  }
} catch (e) {
  // Fallback to hardcoded quote if API fails
}

// Calculate years on GitHub
const createdAt = new Date(githubUser.created_at);
const yearsOnGithub = Math.floor((new Date() - createdAt) / (1000 * 60 * 60 * 24 * 365));

// Get top languages
const languages = repos.reduce((acc, repo) => {
  if (repo.language) {
    acc[repo.language] = (acc[repo.language] || 0) + 1;
  }
  return acc;
}, {});

const topLanguages = Object.entries(languages)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 3)
  .map(([lang]) => lang);

// Get starred repos count
const totalStars = repos.reduce((acc, repo) => acc + repo.stargazers_count, 0);

// Get recent activity (repos updated in last 30 days)
const thirtyDaysAgo = new Date();
thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
const recentActivity = repos.filter(repo => new Date(repo.updated_at) > thirtyDaysAgo).length;
---

