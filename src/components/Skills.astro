---
// Skills & Tools — nube de "píldoras" alrededor de la foto central.
// La FOTO (person_icon) NO vive aquí: es un único elemento compartido,
// controlado desde Clients, que aparece grande en este centro y se encoge/baja
// con el scroll hasta convertirse en el avatar que recorre la trayectoria.
// Aquí solo van las píldoras de skills/tools, que flotan suavemente.

// Cada píldora: text · c (color de marca) · sz (tamaño, vw) · tx (vw) · ty (vh) · rot
// tx/ty = desplazamiento desde el centro (donde está la foto).
// Distribución en ÓVALO alrededor de la foto (posiciones tipo reloj, radios
// variados para que se vea orgánico). Los nombres largos van arriba/abajo al
// centro (donde hay ancho); los cortos, en los laterales.
const stickers = [
  { text: 'PostgreSQL', c: '#5B8DEF', sz: 2.0, tx: 0, ty: -34, rot: -3 }, // 12h
  { text: 'Next.js', c: '#E2E8F0', sz: 2.2, tx: 19, ty: -29, rot: 5 }, // 1h
  { text: 'Node.js', c: '#8CC84B', sz: 2.4, tx: 30, ty: -13, rot: -6 }, // 2h
  { text: 'AWS', c: '#FF9900', sz: 2.2, tx: 34, ty: 4, rot: 4 }, // 3h
  { text: 'NestJS', c: '#E0234E', sz: 2.0, tx: 29, ty: 19, rot: -5 }, // 4h
  { text: 'Docker', c: '#2496ED', sz: 2.2, tx: 18, ty: 31, rot: 6 }, // 5h
  { text: 'TypeScript', c: '#3178C6', sz: 2.2, tx: -2, ty: 36, rot: -3 }, // 6h
  { text: 'MongoDB', c: '#4DB33D', sz: 2.0, tx: -19, ty: 30, rot: 5 }, // 7h
  { text: 'Redis', c: '#F0503A', sz: 1.9, tx: -30, ty: 16, rot: -6 }, // 8h
  { text: 'Git', c: '#F05032', sz: 1.9, tx: -35, ty: 2, rot: 6 }, // 9h
  { text: 'Tailwind', c: '#38BDF8', sz: 2.1, tx: -30, ty: -14, rot: -5 }, // 10h
  { text: 'React', c: '#61DAFB', sz: 2.6, tx: -19, ty: -30, rot: 7 }, // 11h
]
---

<section id="skills" class="skills">
  <div class="skills-pin">
    <p class="skills-eyebrow">Stack &amp; herramientas</p>

    <div class="skills-stage">
      <!-- El hueco central lo ocupa la foto compartida (posición fija),
           renderizada una sola vez desde Clients. -->
      {stickers.map((s) => (
        <span
          class="sticker"
          style={`--c:${s.c}; --sz:${s.sz}; --tx:${s.tx}vw; --ty:${s.ty}vh; --rot:${s.rot}deg`}
        >
          <span class="sticker-inner">{s.text}</span>
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    position: relative;
    /* Alto extra = margen de scroll (la foto se mantiene grande y centrada
       mientras dura el pin; encoge al final, ya gestionado desde Clients). */
    height: 160vh;
  }

  .skills-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(
      circle at 50% 48%,
      rgba(255, 255, 255, 0.05),
      transparent 42%
    );
  }

  .skills-eyebrow {
    position: absolute;
    top: clamp(1.5rem, 5vh, 3rem);
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.72rem;
    font-weight: 600;
    color: #7c7a89;
  }

  /* Punto central: ancla de referencia (la foto va aparte). */
  .skills-stage {
    position: relative;
    width: 0;
    height: 0;
  }

  /* Contenedor de posición (transform estático); la animación va en el hijo. */
  .sticker {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    transform: translate(-50%, -50%) translate(var(--tx), var(--ty))
      rotate(var(--rot));
  }

  /* Píldora pastel (estilo tarjetita) — el color sale de --c. */
  .sticker-inner {
    --bg: color-mix(in srgb, var(--c) 20%, #fff);
    --fg: color-mix(in srgb, var(--c) 68%, #20203a);
    display: inline-block;
    padding: 0.42em 1.05em;
    border-radius: 999px;
    background: var(--bg);
    color: var(--fg);
    font-family: 'Cherry Bomb One', system-ui, sans-serif;
    font-size: clamp(0.9rem, calc(var(--sz) * 1vw + 0.4rem), 1.5rem);
    line-height: 1.15;
    white-space: nowrap;
    cursor: default;
    box-shadow:
      0 12px 22px -10px rgba(20, 20, 45, 0.55),
      inset 0 -2px 4px rgba(0, 0, 0, 0.08),
      inset 0 2px 3px rgba(255, 255, 255, 0.6);
    will-change: transform;
  }

  @media (max-width: 768px) {
    .sticker-inner {
      font-size: clamp(0.78rem, calc(var(--sz) * 1.4vw + 0.3rem), 1.15rem);
      padding: 0.38em 0.85em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skills {
      height: auto;
      min-height: 100vh;
    }
    .skills-pin {
      position: relative;
    }
  }
</style>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (!reduceMotion) {
    // Animación de CARGA (una sola vez): las píldoras aparecen con un "pop"
    // escalonado al entrar la sección. Sin bucle: quedan quietas después.
    // El scale/opacity va en `.sticker-inner` para no pisar el transform de
    // posición que vive en `.sticker`.
    gsap.from('.sticker-inner', {
      scale: 0.3,
      opacity: 0,
      duration: 0.6,
      ease: 'back.out(1.7)',
      stagger: { amount: 0.7, from: 'center' },
      scrollTrigger: { trigger: '.skills', start: 'top 70%', once: true },
    })
  }
</script>
